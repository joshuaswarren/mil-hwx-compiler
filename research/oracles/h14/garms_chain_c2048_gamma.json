  "mil": "program(1.3)\n[buildInfo = dict<string, string>({})]\n{\n  func main<ios18>(tensor<fp16, [1, 2048, 1, 1]> x) {\n    tensor<fp16, [1, 2048, 1, 1]> gamma = const()[name = string(\"gamma\"), val = tensor<fp16, [1, 2048, 1, 1]>(BLOBFILE(path = string(\"@model_path/weights.bin\"), offset = uint64(64)))];\n    tensor<fp16, [1, 2048, 1, 1]> abs0 = abs(x = x)[name = string(\"abs0\")];\n    tensor<int32, [3]> axes = const()[name = string(\"axes\"), val = tensor<int32, [3]>([1, 2, 3])];\n    tensor<fp16, [1, 1, 1, 1]> amax = reduce_max(x = abs0, axes = axes, keep_dims = bool(true))[name = string(\"amax\")];\n    tensor<fp16, [1, 2048, 1, 1]> scaled = real_div(x = x, y = amax)[name = string(\"scaled\")];\n    tensor<fp16, [1, 2048, 1, 1]> sq = square(x = scaled)[name = string(\"sq\")];\n    tensor<fp16, [1, 1, 1, 1]> mean = reduce_mean(x = sq, axes = axes, keep_dims = bool(true))[name = string(\"mean\")];\n    fp16 eps = const()[name = string(\"eps\"), val = fp16(0x1p-17)];\n    tensor<fp16, [1, 1, 1, 1]> meps = add(x = mean, y = eps)[name = string(\"meps\")];\n    tensor<fp16, [1, 1, 1, 1]> rms = sqrt(x = meps)[name = string(\"rms\")];\n    tensor<fp16, [1, 1, 1, 1]> rscaled = mul(x = rms, y = amax)[name = string(\"rscaled\")];\n    tensor<fp16, [1, 2048, 1, 1]> norm = real_div(x = x, y = rscaled)[name = string(\"norm\")];\n    tensor<fp16, [1, 2048, 1, 1]> y = mul(x = norm, y = gamma)[name = string(\"y\")];\n  } -> (y);\n}\n",
