  "mil": "program(1.3)\n[buildInfo = dict<string, string>({})]\n{\n  func main<ios18>(tensor<fp16, [1, 128, 256]> x) {\n    tensor<int32, [1]> axs = const()[name = string(\"axs\"), val = tensor<int32, [1]>([-1])];\n    tensor<fp16, [1, 128, 256]> n1 = layer_norm(x = x, axes = axs, epsilon = fp32(0.00001))[name = string(\"n1\")];\n    tensor<fp16, [256, 256]> c2 = const()[name = string(\"c2\"), val = tensor<fp16, [256, 256]>(BLOBFILE(path = string(\"@model_path/weights.bin\"), offset = uint64(64)))];\n    bool f = const()[name = string(\"f\"), val = bool(false)];\n    bool t = const()[name = string(\"t\"), val = bool(true)];\n    tensor<fp16, [1, 128, 256]> m3 = matmul(transpose_x = f, transpose_y = t, x = n1, y = c2)[name = string(\"m3\")];\n  } -> (m3);\n}\n",
