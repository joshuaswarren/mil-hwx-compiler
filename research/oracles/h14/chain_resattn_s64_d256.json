  "mil": "program(1.3)\n[buildInfo = dict<string, string>({})]\n{\n  func main<ios18>(tensor<fp16, [1, 64, 256]> x) {\n    bool f = const()[name = string(\"f\"), val = bool(false)];\n    bool t = const()[name = string(\"t\"), val = bool(true)];\n    tensor<fp16, [1, 64, 64]> m1 = matmul(transpose_x = f, transpose_y = t, x = x, y = x)[name = string(\"m1\")];\n    fp16 sc = const()[name = string(\"sc\"), val = fp16(0x1p-3)];\n    tensor<fp16, [1, 64, 64]> p2 = mul(x = m1, y = sc)[name = string(\"p2\")];\n    int32 ax = const()[name = string(\"ax\"), val = int32(-1)];\n    tensor<fp16, [1, 64, 64]> s3 = softmax(x = p2, axis = ax)[name = string(\"s3\")];\n    tensor<fp16, [1, 64, 256]> m4 = matmul(transpose_x = f, transpose_y = f, x = s3, y = x)[name = string(\"m4\")];\n    tensor<fp16, [1, 64, 256]> a5 = add(x = x, y = m4)[name = string(\"a5\")];\n  } -> (a5);\n}\n",
