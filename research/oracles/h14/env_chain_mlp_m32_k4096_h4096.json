  "mil": "program(1.3)\n[buildInfo = dict<string, string>({})]\n{\n  func main<ios18>(tensor<fp16, [32, 4096]> x) {\n    bool f = const()[name = string(\"f\"), val = bool(false)];\n    bool t = const()[name = string(\"t\"), val = bool(true)];\n    tensor<fp16, [4096, 4096]> w1 = const()[name = string(\"w1\"), val = tensor<fp16, [4096, 4096]>(BLOBFILE(path = string(\"@model_path/weights.bin\"), offset = uint64(64)))];\n    tensor<fp16, [32, 4096]> h = matmul(transpose_x = f, transpose_y = t, x = x, y = w1)[name = string(\"h\")];\n    tensor<fp16, [32, 4096]> a = gelu(x = h, mode = string(\"EXACT\"))[name = string(\"a\")];\n    tensor<fp16, [4096, 4096]> w2 = const()[name = string(\"w2\"), val = tensor<fp16, [4096, 4096]>(BLOBFILE(path = string(\"@model_path/weights.bin\"), offset = uint64(64)))];\n    tensor<fp16, [32, 4096]> y = matmul(transpose_x = f, transpose_y = t, x = a, y = w2)[name = string(\"y\")];\n  } -> (y);\n}\n",
