  "mil": "program(1.3)\n[buildInfo = dict<string, string>({})]\n{\n  func main<ios18>(tensor<fp16, [1, 128, 512]> x) {\n    tensor<fp16, [512, 512]> c1 = const()[name = string(\"c1\"), val = tensor<fp16, [512, 512]>(BLOBFILE(path = string(\"@model_path/weights.bin\"), offset = uint64(64)))];\n    bool f = const()[name = string(\"f\"), val = bool(false)];\n    bool t = const()[name = string(\"t\"), val = bool(true)];\n    tensor<fp16, [1, 128, 512]> m2 = matmul(transpose_x = f, transpose_y = t, x = x, y = c1)[name = string(\"m2\")];\n    tensor<fp16, [1, 128, 512]> m3 = matmul(transpose_x = f, transpose_y = t, x = x, y = c1)[name = string(\"m3\")];\n    tensor<fp16, [1, 128, 512]> m4 = matmul(transpose_x = f, transpose_y = t, x = x, y = c1)[name = string(\"m4\")];\n    tensor<fp16, [1, 128, 512]> m5 = matmul(transpose_x = f, transpose_y = t, x = x, y = c1)[name = string(\"m5\")];\n    tensor<fp16, [1, 128, 512]> a6 = add(x = m2, y = m3)[name = string(\"a6\")];\n    tensor<fp16, [1, 128, 512]> a7 = add(x = a6, y = m4)[name = string(\"a7\")];\n    tensor<fp16, [1, 128, 512]> a8 = add(x = a7, y = m5)[name = string(\"a8\")];\n  } -> (a8);\n}\n",
