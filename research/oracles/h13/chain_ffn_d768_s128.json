  "mil": "program(1.3)\n[buildInfo = dict<string, string>({})]\n{\n  func main<ios18>(tensor<fp16, [1, 128, 768]> x) {\n    tensor<fp16, [3072, 768]> c1 = const()[name = string(\"c1\"), val = tensor<fp16, [3072, 768]>(BLOBFILE(path = string(\"@model_path/weights.bin\"), offset = uint64(64)))];\n    bool f = const()[name = string(\"f\"), val = bool(false)];\n    bool t = const()[name = string(\"t\"), val = bool(true)];\n    tensor<fp16, [1, 128, 3072]> m2 = matmul(transpose_x = f, transpose_y = t, x = x, y = c1)[name = string(\"m2\")];\n    tensor<fp16, [1, 128, 3072]> g3 = gelu(x = m2, mode = string(\"EXACT\"))[name = string(\"g3\")];\n    tensor<fp16, [768, 3072]> c4 = const()[name = string(\"c4\"), val = tensor<fp16, [768, 3072]>(BLOBFILE(path = string(\"@model_path/weights.bin\"), offset = uint64(88)))];\n    tensor<fp16, [1, 128, 768]> m5 = matmul(transpose_x = f, transpose_y = t, x = g3, y = c4)[name = string(\"m5\")];\n  } -> (m5);\n}\n",
