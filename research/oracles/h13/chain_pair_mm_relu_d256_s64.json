  "mil": "program(1.3)\n[buildInfo = dict<string, string>({})]\n{\n  func main<ios18>(tensor<fp16, [1, 64, 256]> x) {\n    tensor<fp16, [256, 256]> c1 = const()[name = string(\"c1\"), val = tensor<fp16, [256, 256]>(BLOBFILE(path = string(\"@model_path/weights.bin\"), offset = uint64(64)))];\n    bool f = const()[name = string(\"f\"), val = bool(false)];\n    bool t = const()[name = string(\"t\"), val = bool(true)];\n    tensor<fp16, [1, 64, 256]> m2 = matmul(transpose_x = f, transpose_y = t, x = x, y = c1)[name = string(\"m2\")];\n    tensor<fp16, [1, 64, 256]> r3 = relu(x = m2)[name = string(\"r3\")];\n  } -> (r3);\n}\n",
