  "mil": "program(1.3)\n[buildInfo = dict<string, string>({})]\n{\n  func main<ios18>(tensor<fp16, [1, 64, 256]> x) {\n    tensor<fp16, [64, 256]> c1 = const()[name = string(\"c1\"), val = tensor<fp16, [64, 256]>(BLOBFILE(path = string(\"@model_path/weights.bin\"), offset = uint64(64)))];\n    bool f = const()[name = string(\"f\"), val = bool(false)];\n    bool t = const()[name = string(\"t\"), val = bool(true)];\n    tensor<fp16, [1, 64, 64]> m2 = matmul(transpose_x = f, transpose_y = t, x = x, y = c1)[name = string(\"m2\")];\n    tensor<fp16, [1, 1, 64]> c3 = const()[name = string(\"c3\"), val = tensor<fp16, [1, 1, 64]>(BLOBFILE(path = string(\"@model_path/weights.bin\"), offset = uint64(88)))];\n    tensor<fp16, [1, 64, 64]> a4 = add(x = m2, y = c3)[name = string(\"a4\")];\n  } -> (a4);\n}\n",
