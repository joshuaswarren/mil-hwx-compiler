  "mil": "program(1.3)\n[buildInfo = dict<string, string>({})]\n{\n  func main<ios18>(tensor<fp16, [1, 2048]> x) {\n    tensor<int32, [1]> axes = const()[name = string(\"axes\"), val = tensor<int32, [1]>([-1])];\n    bool f = const()[name = string(\"f\"), val = bool(false)];\n    bool t = const()[name = string(\"t\"), val = bool(true)];\n    tensor<fp16, [1, 2048]> n = layer_norm(x = x, axes = axes, epsilon = fp32(0.00001))[name = string(\"n\")];\n    tensor<fp16, [4096, 2048]> w = const()[name = string(\"w\"), val = tensor<fp16, [4096, 2048]>(BLOBFILE(path = string(\"@model_path/weights.bin\"), offset = uint64(64)))];\n    tensor<fp16, [1, 4096]> y = matmul(transpose_x = f, transpose_y = t, x = n, y = w)[name = string(\"y\")];\n  } -> (y);\n}\n",
