  "mil": "program(1.3)\n[buildInfo = dict<string, string>({})]\n{\n  func main<ios18>(tensor<fp16, [1, 64, 375, 80]> x) {\n    tensor<int32, [5]> sh = const()[name = string(\"sh\"), val = tensor<int32, [5]>([1, 32, 2, 375, 80])];\n    tensor<fp16, [1, 32, 2, 375, 80]> r = reshape(x = x, shape = sh)[name = string(\"r\")];\n    tensor<int32, [3]> ax = const()[name = string(\"ax\"), val = tensor<int32, [3]>([2, 3, 4])];\n    bool kd = const()[name = string(\"kd\"), val = bool(true)];\n    tensor<fp16, [1, 32, 1, 1, 1]> mu = reduce_mean(x = r, axes = ax, keep_dims = kd)[name = string(\"mu\")];\n    tensor<fp16, [1, 32, 2, 375, 80]> c = sub(x = r, y = mu)[name = string(\"c\")];\n    tensor<fp16, [1, 32, 2, 375, 80]> sq = mul(x = c, y = c)[name = string(\"sq\")];\n    tensor<fp16, [1, 32, 1, 1, 1]> va = reduce_mean(x = sq, axes = ax, keep_dims = kd)[name = string(\"va\")];\n    tensor<fp16, [1, 32, 1, 1, 1]> sd = sqrt(x = va)[name = string(\"sd\")];\n    tensor<fp16, [1, 32, 2, 375, 80]> n = real_div(x = c, y = sd)[name = string(\"n\")];\n    tensor<int32, [4]> sh2 = const()[name = string(\"sh2\"), val = tensor<int32, [4]>([1, 64, 375, 80])];\n    tensor<fp16, [1, 64, 375, 80]> y = reshape(x = n, shape = sh2)[name = string(\"y\")];\n  } -> (y);\n}\n",
