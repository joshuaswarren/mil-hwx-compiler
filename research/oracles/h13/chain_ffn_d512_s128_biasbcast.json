  "mil": "program(1.3)\n[buildInfo = dict<string, string>({})]\n{\n  func main<ios18>(tensor<fp16, [1, 128, 512]> x) {\n    tensor<fp16, [2048, 512]> c1 = const()[name = string(\"c1\"), val = tensor<fp16, [2048, 512]>(BLOBFILE(path = string(\"@model_path/weights.bin\"), offset = uint64(64)))];\n    bool f = const()[name = string(\"f\"), val = bool(false)];\n    bool t = const()[name = string(\"t\"), val = bool(true)];\n    tensor<fp16, [1, 128, 2048]> m2 = matmul(transpose_x = f, transpose_y = t, x = x, y = c1)[name = string(\"m2\")];\n    tensor<fp16, [1, 1, 2048]> c3 = const()[name = string(\"c3\"), val = tensor<fp16, [1, 1, 2048]>(BLOBFILE(path = string(\"@model_path/weights.bin\"), offset = uint64(88)))];\n    tensor<fp16, [1, 128, 2048]> a4 = add(x = m2, y = c3)[name = string(\"a4\")];\n    tensor<fp16, [1, 128, 2048]> g5 = gelu(x = a4, mode = string(\"EXACT\"))[name = string(\"g5\")];\n    tensor<fp16, [512, 2048]> c6 = const()[name = string(\"c6\"), val = tensor<fp16, [512, 2048]>(BLOBFILE(path = string(\"@model_path/weights.bin\"), offset = uint64(112)))];\n    tensor<fp16, [1, 128, 512]> m7 = matmul(transpose_x = f, transpose_y = t, x = g5, y = c6)[name = string(\"m7\")];\n    tensor<fp16, [1, 1, 512]> c8 = const()[name = string(\"c8\"), val = tensor<fp16, [1, 1, 512]>(BLOBFILE(path = string(\"@model_path/weights.bin\"), offset = uint64(136)))];\n    tensor<fp16, [1, 128, 512]> a9 = add(x = m7, y = c8)[name = string(\"a9\")];\n  } -> (a9);\n}\n",
