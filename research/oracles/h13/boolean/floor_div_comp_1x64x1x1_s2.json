  "mil": "program(1.3)\n[buildInfo = dict<string, string>({})]\n{\n  func main<ios18>(tensor<fp16, [1, 64, 1, 1]> x) {\n    fp16 two = const()[name = string(\"two\"), val = fp16(2.0)];\n    tensor<fp16, [1, 64, 1, 1]> q = real_div(x = x, y = two)[name = string(\"q\")];\n    tensor<fp16, [1, 64, 1, 1]> y = floor(x = q)[name = string(\"y\")];\n  } -> (y);\n}\n",
