program(1.3)
[buildInfo = dict<string, string>({})]
{
  func main<ios18>(tensor<fp16, [1, 1, 128, 128]> a, tensor<fp16, [1, 1, 128, 128]> b) {
    fp16 scale = const()[name = string("scale"), val = fp16(0.25)];
    bool f = const()[name = string("f"), val = bool(false)];
    tensor<fp16, [1, 1, 128, 128]> t = matmul(transpose_x = f, transpose_y = f, x = a, y = b)[name = string("t")];
    tensor<fp16, [1, 1, 128, 128]> y = mul(x = t, y = scale)[name = string("y")];
  } -> (y);
}
