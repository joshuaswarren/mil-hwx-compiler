program(1.3)
[buildInfo = dict<string, string>({})]
{
  func main<ios18>(tensor<fp16, [1, 1, 256, 256]> a, tensor<fp16, [1, 1, 256, 256]> b) {
    fp16 scale = const()[name = string("scale"), val = fp16(0.08838834764831845)];
    bool f = const()[name = string("f"), val = bool(false)];
    tensor<fp16, [1, 1, 256, 256]> t = matmul(transpose_x = f, transpose_y = f, x = a, y = b)[name = string("t")];
    tensor<fp16, [1, 1, 256, 256]> y = mul(x = t, y = scale)[name = string("y")];
  } -> (y);
}
