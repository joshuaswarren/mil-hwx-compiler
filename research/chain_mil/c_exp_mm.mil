program(1.3)
[buildInfo = dict<string, string>({})]
{
  func main<ios18>(tensor<fp16, [1, 1, 128, 128]> a, tensor<fp16, [1, 1, 128, 128]> b) {
    bool f = const()[name = string("f"), val = bool(false)];
    tensor<fp16, [1, 1, 128, 128]> t = exp(x = a)[name = string("t")];
    tensor<fp16, [1, 1, 128, 128]> y = matmul(transpose_x = f, transpose_y = f, x = t, y = b)[name = string("y")];
  } -> (y);
}
