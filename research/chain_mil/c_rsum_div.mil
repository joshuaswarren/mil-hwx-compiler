program(1.3)
[buildInfo = dict<string, string>({})]
{
  func main<ios18>(tensor<fp16, [1, 1, 128, 128]> x) {
    tensor<int32, [1]> ax = const()[name = string("ax"), val = tensor<int32, [1]>([3])];
    tensor<fp16, [1, 1, 128, 1]> s = reduce_sum(x = x, axes = ax, keep_dims = bool(true))[name = string("s")];
    tensor<fp16, [1, 1, 128, 128]> y = real_div(x = x, y = s)[name = string("y")];
  } -> (y);
}
