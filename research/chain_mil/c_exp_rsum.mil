program(1.3)
[buildInfo = dict<string, string>({})]
{
  func main<ios18>(tensor<fp16, [1, 1, 128, 128]> x) {
    tensor<int32, [1]> ax = const()[name = string("ax"), val = tensor<int32, [1]>([3])];
    tensor<fp16, [1, 1, 128, 128]> t = exp(x = x)[name = string("t")];
    tensor<fp16, [1, 1, 128, 1]> y = reduce_sum(x = t, axes = ax, keep_dims = bool(true))[name = string("y")];
  } -> (y);
}
