program(1.3)
[buildInfo = dict<string, string>({})]
{
  func main<ios18>(tensor<fp16, [1, 768]> x) {
    tensor<fp16, [1024, 768]> w1 = const()[name = string("w1"), val = tensor<fp16, [1024, 768]>(BLOBFILE(path = string("@model_path/mlp-w1.bin"), offset = uint64(64)))];
    tensor<fp16, [1024]> b1 = const()[name = string("b1"), val = tensor<fp16, [1024]>(BLOBFILE(path = string("@model_path/mlp-b1.bin"), offset = uint64(64)))];
    tensor<fp16, [1, 1024]> hidden = linear(x = x, weight = w1, bias = b1)[name = string("hidden")];
    tensor<fp16, [1, 1024]> activated = relu(x = hidden)[name = string("activated")];
    tensor<fp16, [768, 1024]> w2 = const()[name = string("w2"), val = tensor<fp16, [768, 1024]>(BLOBFILE(path = string("@model_path/mlp-w2.bin"), offset = uint64(64)))];
    tensor<fp16, [768]> b2 = const()[name = string("b2"), val = tensor<fp16, [768]>(BLOBFILE(path = string("@model_path/mlp-b2.bin"), offset = uint64(64)))];
    tensor<fp16, [1, 768]> projected = linear(x = activated, weight = w2, bias = b2)[name = string("projected")];
    tensor<fp16, [1, 768]> y = add(x = projected, y = x)[name = string("residual")];
  } -> (y);
}
