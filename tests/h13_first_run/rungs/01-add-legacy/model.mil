program(1.3)
[buildInfo = dict<string, string>({})]
{
  func main<ios18>(tensor<fp16, [1, 64, 1, 1]> a) {
    tensor<fp16, [1, 64, 1, 1]> c = const()[name = string("c"), val = tensor<fp16, [1, 64, 1, 1]>(BLOBFILE(path = string("@model_path/c.bin"), offset = uint64(64)))];
    tensor<fp16, [1, 64, 1, 1]> y = add(x = a, y = c)[name = string("binary")];
  } -> (y);
}
