program(1.3)
[buildInfo = dict<string, string>({})]
{
  func main<ios18>(tensor<fp16, [1, 64, 64]> x, tensor<fp16, [1, 64, 64]> w) {
    bool tx = const()[name = string("tx"), val = bool(false)];
    bool ty = const()[name = string("ty"), val = bool(false)];
    tensor<fp16, [1, 64, 64]> y = matmul(transpose_x = tx, transpose_y = ty, x = x, y = w)[name = string("y")];
  } -> (y);
}
