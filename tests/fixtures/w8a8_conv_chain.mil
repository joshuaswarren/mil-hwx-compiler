program(1.3)
[buildInfo = dict<string, string>({})]
{
  func main<ios18>(tensor<fp16, [1, 64, 64, 64]> x) {
    string pt = const()[name = string("pt"), val = string("valid")];
    tensor<int32, [2]> st = const()[name = string("st"), val = tensor<int32, [2]>([1, 1])];
    tensor<int32, [4]> pd = const()[name = string("pd"), val = tensor<int32, [4]>([0, 0, 0, 0])];
    tensor<int32, [2]> dl = const()[name = string("dl"), val = tensor<int32, [2]>([1, 1])];
    int32 gp = const()[name = string("gp"), val = int32(1)];
    fp16 qs = const()[name = string("qs"), val = fp16(0x1p-3)];
    string qd = const()[name = string("qd"), val = string("int8")];
    fp16 dqs = const()[name = string("dqs"), val = fp16(0x1p-3)];
    tensor<fp16, [64, 64, 1, 1]> W0 = constexpr_affine_dequantize()[axis = int32(0), name = string("W0"), quantized_data = tensor<int8, [64, 64, 1, 1]>(BLOBFILE(path = string("@model_path/weights/weight.bin"), offset = uint64(64))), scale = fp16(0x1p-3), zero_point = int8(0)];
    tensor<fp16, [1, 64, 64, 64]> c0 = conv(dilations = dl, groups = gp, pad = pd, pad_type = pt, strides = st, weight = W0, x = x)[name = string("c0")];
    tensor<int8, [1, 64, 64, 64]> q0 = quantize(input = c0, output_dtype = qd, scale = qs)[name = string("q0")];
    tensor<fp16, [1, 64, 64, 64]> dq0 = dequantize(input = q0, scale = dqs)[name = string("dq0")];
    tensor<fp16, [64, 64, 1, 1]> W1 = constexpr_affine_dequantize()[axis = int32(0), name = string("W1"), quantized_data = tensor<int8, [64, 64, 1, 1]>(BLOBFILE(path = string("@model_path/weights/weight.bin"), offset = uint64(4224))), scale = fp16(0x1p-3), zero_point = int8(0)];
    tensor<fp16, [1, 64, 64, 64]> c1 = conv(dilations = dl, groups = gp, pad = pd, pad_type = pt, strides = st, weight = W1, x = dq0)[name = string("c1")];
    tensor<int8, [1, 64, 64, 64]> q1 = quantize(input = c1, output_dtype = qd, scale = qs)[name = string("q1")];
    tensor<fp16, [1, 64, 64, 64]> dq1 = dequantize(input = q1, scale = dqs)[name = string("dq1")];
    tensor<fp16, [64, 64, 1, 1]> W2 = constexpr_affine_dequantize()[axis = int32(0), name = string("W2"), quantized_data = tensor<int8, [64, 64, 1, 1]>(BLOBFILE(path = string("@model_path/weights/weight.bin"), offset = uint64(8384))), scale = fp16(0x1p-3), zero_point = int8(0)];
    tensor<fp16, [1, 64, 64, 64]> c2 = conv(dilations = dl, groups = gp, pad = pd, pad_type = pt, strides = st, weight = W2, x = dq1)[name = string("c2")];
    tensor<int8, [1, 64, 64, 64]> q2 = quantize(input = c2, output_dtype = qd, scale = qs)[name = string("q2")];
    tensor<fp16, [1, 64, 64, 64]> dq2 = dequantize(input = q2, scale = dqs)[name = string("dq2")];
    tensor<fp16, [64, 64, 1, 1]> W3 = constexpr_affine_dequantize()[axis = int32(0), name = string("W3"), quantized_data = tensor<int8, [64, 64, 1, 1]>(BLOBFILE(path = string("@model_path/weights/weight.bin"), offset = uint64(12544))), scale = fp16(0x1p-3), zero_point = int8(0)];
    tensor<fp16, [1, 64, 64, 64]> c3 = conv(dilations = dl, groups = gp, pad = pd, pad_type = pt, strides = st, weight = W3, x = dq2)[name = string("c3")];
  } -> (c3);
}
