program(1.3)
[buildInfo = dict<string, string>({})]
{
  func main<ios18>(tensor<fp16, [1, 256, 32, 32]> x) {
    int32 block = const()[name = string("block"), val = int32(4)];
    tensor<fp16, [1, 16, 128, 128]> y = depth_to_space(
      x = x,
      block_size = block
    )[name = string("unpack")];
  } -> (y);
}
