program(1.3)
[buildInfo = dict<string, string>({})]
{
  func main<ios18>(tensor<fp16, [1, 1, 128, 128]> state, tensor<fp16, [1, 1, 128, 128]> a0, tensor<fp16, [1, 1, 128, 128]> b0, tensor<fp16, [1, 1, 128, 128]> a1, tensor<fp16, [1, 1, 128, 128]> b1, tensor<fp16, [1, 1, 128, 128]> a2, tensor<fp16, [1, 1, 128, 128]> b2, tensor<fp16, [1, 1, 128, 128]> a3, tensor<fp16, [1, 1, 128, 128]> b3) {
    tensor<fp16, [1, 1, 128, 128]> p0 = mul(x = state, y = a0)[name = string("p0")];
    tensor<fp16, [1, 1, 128, 128]> s0 = add(x = p0, y = b0)[name = string("s0")];
    tensor<fp16, [1, 1, 128, 128]> p1 = mul(x = s0, y = a1)[name = string("p1")];
    tensor<fp16, [1, 1, 128, 128]> s1 = add(x = p1, y = b1)[name = string("s1")];
    tensor<fp16, [1, 1, 128, 128]> p2 = mul(x = s1, y = a2)[name = string("p2")];
    tensor<fp16, [1, 1, 128, 128]> s2 = add(x = p2, y = b2)[name = string("s2")];
    tensor<fp16, [1, 1, 128, 128]> p3 = mul(x = s2, y = a3)[name = string("p3")];
    tensor<fp16, [1, 1, 128, 128]> y = add(x = p3, y = b3)[name = string("s3")];
  } -> (y);
}
